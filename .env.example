# OmniBridge waitlist backend. Copy to .env.local for local dev.
# In Vercel, set these in Project Settings > Environment Variables ONLY.
# Never commit real values (the repo is public). None of these use NEXT_PUBLIC_.

# Supabase (server-only). The service role key bypasses RLS: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt for HMAC-SHA256 of client IPs (rate limiting). Raw IPs are never stored.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Public site origin used to build referral share links (no trailing slash).
SITE_URL=http://localhost:3000
# Optional comma-separated Origin allow-list for POST /api/waitlist. Empty = not enforced.
ALLOWED_ORIGINS=

# Confirmation email. OFF until Claire clears a sending domain. Signups work without it.
WAITLIST_EMAIL_ENABLED=false
RESEND_API_KEY=
# e.g. "OmniBridge <waitlist@your-domain>". Left empty until the sender domain is decided.
RESEND_FROM=
RESEND_REPLY_TO=
# Merge value for {{unsubscribe_url}} in the confirmation email. No unsubscribe endpoint exists yet;
# the email will NOT send while this is empty or while the copy still has placeholders.
WAITLIST_UNSUBSCRIBE_URL=

# Rate limits (fixed window, per hashed IP)
WAITLIST_SIGNUP_RATE_LIMIT=5
WAITLIST_SIGNUP_RATE_WINDOW_SECONDS=600
WAITLIST_POSITION_RATE_LIMIT=30
WAITLIST_POSITION_RATE_WINDOW_SECONDS=600

# Opt-in Gmail dot/plus canonicalisation for duplicate detection. Default off.
WAITLIST_CANONICALISE_GMAIL=false

# PREVIEW ONLY. Comma-separated reserved test domains (e.g. example.com) to accept for QA addresses
# like ob-qa+<case-id>@example.com. Reserved domains (example.com/.org/.net, *.test, *.invalid,
# *.example, *.localhost) are rejected with 400 invalid_email by default. This allowlist is IGNORED
# in production (VERCEL_ENV=production, or NODE_ENV=production outside Vercel). Never set it on Production.
WAITLIST_TEST_EMAIL_DOMAINS=
