{
  "$meta": { "version": "1.2.0", "owner": "OB Art Director", "date": "2026-10-27", "status": "approved — M2 closed by Claire 2026-10-27", "brandName": "BRAND.name only (nav.wordmark and footer.wordmark must equal it)" },
  "color": {
    "bg":           { "value": "#070B14", "role": "page base, near-black navy" },
    "bg-1":         { "value": "#0B1220", "role": "section alternation" },
    "surface":      { "value": "#111A2E", "role": "cards, panels, glass base" },
    "surface-2":    { "value": "#17223A", "role": "inputs, chips, agent-label chips" },
    "surface-3":    { "value": "#1E2B47", "role": "hover/raised surface, cmd-K selected row" },
    "line":         { "value": "#2A3A5C", "role": "decorative hairlines, grid (non-essential, no contrast requirement)" },
    "line-strong":  { "value": "#61759C", "role": "input and control borders (>=3:1 on bg/surface/surface-2)" },
    "text-1":       { "value": "#F1F5FB", "role": "headings, body, focus ring" },
    "text-2":       { "value": "#AEB9CC", "role": "secondary body" },
    "text-3":       { "value": "#8793A8", "role": "meta/legal on SOLID surfaces only; banned on glass and over 3D" },
    "cyan":         { "value": "#22D3EE", "role": "primary light: packets, links, primary button fill, eyebrows" },
    "cyan-300":     { "value": "#67E8F9", "role": "link hover, packet core highlight" },
    "on-cyan":      { "value": "#04121A", "role": "label text on cyan fill" },
    "violet":       { "value": "#8B5CF6", "role": "secondary light: clusters, bridges, glow. BANNED as text" },
    "violet-text":  { "value": "#B69CFF", "role": "violet text: agent labels on solid chips" },
    "amber":        { "value": "#F5B544", "role": "form errors and warnings (with icon + text). Never red" },
    "amber-tint":   { "value": "#32343B", "role": "errored field background (amber 12% over surface-2). Placeholder on it uses text-2 (6.28:1); text-3 is not allowed here" },
    "success":      { "value": "#5EEAD4", "role": "success ticks, signed-record stamp, 'approved' state" },
    "alert-red":    { "value": "#FF3B4E", "role": "RESERVED: RedAlertModal, KillSwitchButton, PausePulse. Nothing else.", "reserved": true },
    "on-red":       { "value": "#16050A", "role": "label text on alert-red fill (kill-switch button only)", "reserved": true },
    "alert-veil":   { "value": "#3C2034", "role": "modal panel bg during RED ALERT (red 18% over surface)", "reserved": true }
  },
  "gradient": {
    "aurora-hero":   "radial-gradient(60% 50% at 70% 35%, rgba(34,211,238,0.18) 0%, rgba(139,92,246,0.12) 40%, rgba(7,11,20,0) 75%)",
    "aurora-violet": "radial-gradient(50% 40% at 20% 70%, rgba(139,92,246,0.20) 0%, rgba(7,11,20,0) 70%)",
    "bridge-line":   "linear-gradient(90deg, rgba(34,211,238,0) 0%, #22D3EE 45%, #8B5CF6 100%)",
    "text-sheen":    "linear-gradient(180deg, #F1F5FB 0%, #AEB9CC 100%)",
    "scrim-hero":    "linear-gradient(180deg, rgba(7,11,20,0.0) 0%, rgba(7,11,20,0.82) 55%, #070B14 100%)",
    "alert-vignette":"radial-gradient(120% 90% at 50% 50%, rgba(255,59,78,0) 55%, rgba(255,59,78,0.22) 100%)"
  },
  "glow": {
    "cyan-sm":  "0 0 12px rgba(34,211,238,0.45)",
    "cyan-md":  "0 0 24px rgba(34,211,238,0.35), 0 0 2px rgba(34,211,238,0.9)",
    "violet-md":"0 0 32px rgba(139,92,246,0.35)",
    "btn-primary-hover": "0 0 0 1px rgba(34,211,238,0.6), 0 8px 32px -8px rgba(34,211,238,0.55)",
    "alert":    "0 0 0 1px #FF3B4E, 0 0 48px rgba(255,59,78,0.35)",
    "bloom-high": { "strength": 0.9, "radius": 0.55, "threshold": 0.62, "luminanceSmoothing": 0.12 }
  },
  "glass": {
    "fill": "rgba(17,26,46,0.80)", "fillMinOpacity": 0.80, "blur": "24px", "saturate": 1.2,
    "border": "1px solid rgba(42,58,92,0.60)", "innerHighlight": "inset 0 1px 0 rgba(241,245,251,0.06)",
    "fallbackNoBackdropFilter": "#111A2E (solid, opacity 0.96)", "rule": "text-1/text-2 only on glass; text-3 and violet-text banned on glass"
  },
  "font": {
    "display": { "family": "Space Grotesk", "weights": [500, 600], "licence": "SIL OFL 1.1", "source": "https://fonts.google.com/specimen/Space+Grotesk", "fallback": "'Space Grotesk Fallback', Arial, sans-serif (size-adjust via next/font)" },
    "body":    { "family": "Inter", "weights": [400, 500, 600], "licence": "SIL OFL 1.1", "source": "https://fonts.google.com/specimen/Inter", "features": "cv11, ss01, tnum on prices" },
    "mono":    { "family": "JetBrains Mono", "weights": [400, 500], "licence": "SIL OFL 1.1", "source": "https://fonts.google.com/specimen/JetBrains+Mono" }
  },
  "type": {
    "_note": "fluid clamp(min@390, max@1440). size / line-height / tracking / weight / family",
    "display-xl": { "size": "clamp(2.75rem, 1.6rem + 4.7vw, 5.75rem)", "lh": 1.02, "tracking": "-0.035em", "weight": 600, "family": "display", "use": "Home H1 only" },
    "display-l":  { "size": "clamp(2.25rem, 1.5rem + 3.1vw, 4.25rem)", "lh": 1.05, "tracking": "-0.03em",  "weight": 600, "family": "display", "use": "page H1" },
    "h2":         { "size": "clamp(1.875rem, 1.35rem + 2.1vw, 3.25rem)", "lh": 1.08, "tracking": "-0.025em", "weight": 600, "family": "display" },
    "h3":         { "size": "clamp(1.375rem, 1.15rem + 0.9vw, 1.875rem)", "lh": 1.2, "tracking": "-0.015em", "weight": 500, "family": "display" },
    "h4":         { "size": "1.125rem", "lh": 1.3, "tracking": "-0.01em", "weight": 600, "family": "body" },
    "body-l":     { "size": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)", "lh": 1.55, "tracking": "-0.005em", "weight": 400, "family": "body" },
    "body":       { "size": "1rem", "lh": 1.6, "tracking": "0", "weight": 400, "family": "body" },
    "body-s":     { "size": "0.875rem", "lh": 1.55, "tracking": "0", "weight": 400, "family": "body" },
    "caption":    { "size": "0.8125rem", "lh": 1.45, "tracking": "0.005em", "weight": 400, "family": "body", "use": "legal, disclaimers; min 13px" },
    "eyebrow":    { "size": "0.75rem", "lh": 1.2, "tracking": "0.14em", "weight": 500, "family": "mono", "transform": "uppercase", "color": "cyan" },
    "mono":       { "size": "0.875rem", "lh": 1.5, "tracking": "0", "weight": 400, "family": "mono", "use": "prices, hashes, logs" },
    "mono-price": { "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem)", "lh": 1.1, "tracking": "-0.01em", "weight": 500, "family": "mono", "features": "tnum" },
    "button":     { "size": "0.9375rem", "lh": 1, "tracking": "-0.005em", "weight": 600, "family": "body" }
  },
  "space": { "0":"0","1":"4px","2":"8px","3":"12px","4":"16px","5":"20px","6":"24px","8":"32px","10":"40px","12":"48px","16":"64px","20":"80px","24":"96px","32":"128px","40":"160px" },
  "section": { "padY-mobile": "96px", "padY-desktop": "160px", "padY-compact-mobile": "64px", "padY-compact-desktop": "112px" },
  "grid": {
    "390":  { "columns": 4,  "margin": "20px", "gutter": "16px" },
    "768":  { "columns": 8,  "margin": "40px", "gutter": "24px" },
    "1280": { "columns": 12, "margin": "64px", "gutter": "24px" },
    "1440": { "columns": 12, "margin": "auto", "gutter": "24px", "container": "1280px" },
    "readingMax": "68ch", "minSupported": "360px"
  },
  "breakpoint": { "sm": "390px", "md": "768px", "lg": "1280px", "xl": "1440px" },
  "radius": { "xs": "6px", "sm": "8px", "md": "12px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "border": { "hairline": "1px", "control": "1px", "focus": "2px" },
  "focus": { "ring": "0 0 0 3px #070B14, 0 0 0 5px #F1F5FB", "rule": "3px bg-coloured gap then 2px text-1 ring; never touches cyan or red fills; :focus-visible only" },
  "z": { "base": 0, "canvas": 0, "content": 10, "nav": 50, "cookie": 60, "cmdk": 70, "transition": 80, "modal": 90, "alert-modal": 95, "toast": 100 },
  "motion": {
    "duration": { "instant": 0.1, "fast": 0.18, "base": 0.32, "slow": 0.56, "slower": 0.9, "transition": 0.7, "reduced": 0.15 },
    "ease": {
      "out":      { "css": "cubic-bezier(0.22, 1, 0.36, 1)",   "gsap": "expo.out",    "use": "entrances, reveals" },
      "inOut":    { "css": "cubic-bezier(0.65, 0, 0.35, 1)",   "gsap": "power3.inOut","use": "camera, transitions" },
      "in":       { "css": "cubic-bezier(0.55, 0, 1, 0.45)",   "gsap": "power2.in",   "use": "exits" },
      "packet":   { "css": "cubic-bezier(0.45, 0, 0.2, 1)",    "gsap": "sine.inOut",  "use": "packets along links" },
      "spring":   { "framer": { "type": "spring", "stiffness": 260, "damping": 30, "mass": 1 }, "use": "UI press, chips" },
      "cursor":   { "framer": { "type": "spring", "stiffness": 120, "damping": 18, "mass": 0.6 }, "use": "cursor bend, packet cursor" },
      "linear":   { "css": "linear", "gsap": "none", "use": "scrubbed scroll" }
    },
    "stagger": { "line": 0.06, "item": 0.08, "bubble": 0.0 },
    "scrub": { "default": 0.6, "mobile": 0.3 }
  }
}
